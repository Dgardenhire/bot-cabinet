{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botcabinet.com/schemas/bot-fit-test-input-v1.json",
  "title": "Bot Cabinet Bot Fit Test input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "description": "The concrete finished result the person needs."
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once",
        "repeat",
        "scheduled"
      ],
      "default": "once"
    },
    "needsContinuingContext": {
      "type": "boolean",
      "default": false
    },
    "needsMultipleSpecialists": {
      "type": "boolean",
      "default": false
    },
    "workProvenManually": {
      "type": "boolean",
      "default": false
    },
    "overlapsExistingRole": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unsure"
      ],
      "default": "unsure"
    },
    "access": {
      "type": "string",
      "maxLength": 4000,
      "default": ""
    },
    "approvals": {
      "type": "string",
      "maxLength": 4000,
      "default": ""
    },
    "trigger": {
      "type": "string",
      "maxLength": 1000,
      "default": ""
    },
    "failurePlan": {
      "type": "string",
      "maxLength": 1000,
      "default": ""
    },
    "costLimit": {
      "type": "string",
      "maxLength": 1000,
      "default": ""
    },
    "shutdown": {
      "type": "string",
      "maxLength": 1000,
      "default": ""
    },
    "override": {
      "type": "string",
      "enum": [
        "auto",
        "assignment",
        "skill",
        "routine",
        "bot",
        "crew"
      ],
      "default": "auto"
    }
  }
}
